generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id            String   @id @default(cuid())
  nome          String
  foto          String   @default("https://i.postimg.cc/m2m9z9z9/default-avatar.png")
  cadastroNum   String   @unique
  password      String
  cargo         String   @default("Editor")
  nivel         String   @default("ADMIN") // SUPER, ADMIN, EDITOR
  status        String   @default("ATIVO")
  dataIngresso  DateTime @default(now())
  ultimoAcesso  DateTime?
}

model Evento {
  id           String   @id @default(cuid())
  nome         String
  data         DateTime
  cidade       String
  banner       String
  linkIngresso String?
  apoiado      Boolean  @default(false)
  destaque     Boolean  @default(false)
  ativo        Boolean  @default(true)
  vistas       Int      @default(0)
  descricao    String?  @db.Text
}

model Banner {
  id        String   @id @default(cuid())
  titulo    String
  imageUrl  String
  ordem     Int      @default(0)
  ativo     Boolean  @default(true)
  inicio    DateTime @default(now())
  fim       DateTime
}
